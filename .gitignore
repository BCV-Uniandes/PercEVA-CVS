# Datasets and checkpoints — not shipped in the repo. In this checkout
# these are symlinks to local paths; see README's Data / Weights sections
# for how to download/reproduce them yourself.
/data/*
!/data/.gitkeep
!/data/organize_sages_splits.py
!/data/sages_splits.json
/weights/*
!/weights/.gitkeep

# Generated training run artifacts (logs, metrics, checkpoints written by
# main_scripts/*.py / run_scripts/*.sh).
/outputs/
wandb/

# Python bytecode caches.
__pycache__/
*.py[cod]

# Editor / OS cruft.
.vscode/
.DS_Store